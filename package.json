{
  "name": "google-search-datepicker",
  "version": "0.0.5",
  "license": "MIT",
  "author": "Hideki Ikemoto",
  "type": "module",
  "scripts": {
    "archive": "tsx ./scripts/archive.ts",
    "build": "pnpm build:vite && pnpm build:manifest",
    "build:manifest": "tsx ./scripts/make_manifest.ts",
    "build:vite": "vite build",
    "deploy": "tsx ./scripts/github_release.ts",
    "fix": "pnpm fix:oxlint && pnpm format",
    "fix:oxlint": "oxlint --fix --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:ci": "pnpm format:check && pnpm lint:tsc && pnpm lint:oxlint",
    "lint:oxlint": "oxlint --report-unused-disable-directives",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "0.3.8",
    "@types/node": "^26.6.11",
    "date-fns": "4.4.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "zip-a-folder": "7.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
